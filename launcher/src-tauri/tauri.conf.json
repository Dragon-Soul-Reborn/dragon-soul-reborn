{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dragon Soul Reborn",
  "identifier": "org.dragonsoulreborn.launcher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dragon Soul Reborn",
        "width": 900,
        "height": 560,
        "resizable": false,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Dragon Soul Reborn",
    "shortDescription": "Dragon Soul Reborn launcher",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/innoextract"
    ],
    "resources": {
      "../../third_party/innoextract/LICENSE.txt": "licenses/innoextract.txt"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA3NkYxREYxOUQ3MjYzRDUKUldUVlkzS2Q4UjF2QitwMHBOY2NFNUtzaUpkUFlRU2M4a3RSOHJOODM3TW5YT3FsM0xYSUx1UUYK",
      "endpoints": [
        "https://github.com/Dragon-Soul-Reborn/dragon-soul-reborn/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
